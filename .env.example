# =============================================================================
# Environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit real secrets.
#
# A single `.env` at the repo root serves both halves of the app:
#   - the server reads it at runtime via `dotenv/config` (server/_core/index.ts)
#   - Vite reads it at build time (`envDir` is the repo root in vite.config.ts)
#
# Every variable below is optional for simply booting the app: `pnpm dev` starts
# and serves the UI with none of them set. Each one gates a specific feature,
# noted per variable.
#
# IMPORTANT: anything prefixed `VITE_` is inlined into the client bundle at
# build time and is therefore PUBLIC — visible to anyone who loads the page.
# Never put a private secret behind a `VITE_` name.


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Which mode the server runs in. "development" mounts Vite as middleware with
# HMR; anything else serves the prebuilt files from dist/public.
# The package.json scripts set this for you (`dev` -> development,
# `start` -> production), so you normally do NOT set this by hand.
NODE_ENV=development

# Port the Express server listens on. Defaults to 3000. If the port is busy the
# server scans upward (up to +20) and logs the port it actually bound to.
PORT=3000


# -----------------------------------------------------------------------------
# Database (MySQL, via Drizzle ORM)
# -----------------------------------------------------------------------------

# MySQL connection string used by both the app and drizzle-kit.
# Format: mysql://user:password@host:port/database
#
# Optional at runtime: the app connects lazily, and without it user records are
# simply not persisted (reads return undefined, writes log a warning and no-op)
# — the rest of the app still works.
# REQUIRED for `pnpm db:push`, which throws immediately if it is unset.
DATABASE_URL=mysql://user:password@localhost:3306/quran_app


# -----------------------------------------------------------------------------
# Authentication (Manus OAuth)
# -----------------------------------------------------------------------------

# Secret used to sign and verify the session JWT stored in the auth cookie.
# Use a long random string, e.g. `openssl rand -hex 32`.
# Required for sign-in: without it sessions are signed with an empty key.
JWT_SECRET=

# Base URL of the OAuth backend the server calls to exchange an authorization
# code for tokens and to look up user info. The server logs a loud startup
# error when this is missing, and the OAuth callback cannot complete.
OAUTH_SERVER_URL=

# Base URL of the OAuth portal the BROWSER is redirected to when a user clicks
# sign in. This is the user-facing login page, distinct from OAUTH_SERVER_URL
# above, which is the server-to-server API.
VITE_OAUTH_PORTAL_URL=

# This app's OAuth application/client ID. Read by BOTH sides: the server sends
# it as the OAuth clientId/projectId, and the client sends it as `appId` when
# starting the login redirect. Despite the `VITE_` prefix it is needed in the
# server process too, so keep it in this one file.
VITE_APP_ID=

# The Manus openId that should be granted the `admin` role automatically the
# first time that user signs in. Leave blank if you do not need an admin.
OWNER_OPEN_ID=


# -----------------------------------------------------------------------------
# Forge API (server-side) — AI, storage, maps, notifications
# -----------------------------------------------------------------------------
# These power recitation/voice transcription, image generation, file uploads
# through presigned URLs, the map proxy, and push notifications. Each of those
# features checks for them and returns a clear error when they are absent; the
# rest of the app is unaffected.

# Base URL of the Forge API, e.g. https://forge.butterfly-effect.dev
BUILT_IN_FORGE_API_URL=

# Bearer token for the Forge API. Server-side only — this is a real secret and
# must never be given a VITE_ prefix.
BUILT_IN_FORGE_API_KEY=


# -----------------------------------------------------------------------------
# Forge API (browser-side) — Google Maps proxy
# -----------------------------------------------------------------------------
# Used only by the Map component, which loads the Maps JS SDK through Forge's
# proxy. Both values ship to the browser.

# Key passed to the Maps proxy in the script URL. Public by construction — use
# a key scoped/restricted for browser use, not the server key above.
VITE_FRONTEND_FORGE_API_KEY=

# Base URL for the browser-side Forge proxy.
# Falls back to https://forge.butterfly-effect.dev when unset.
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev


# -----------------------------------------------------------------------------
# Analytics (Umami) — optional
# -----------------------------------------------------------------------------
# Substituted into client/index.html at build time. If you leave these blank,
# the placeholders are emitted into the built HTML verbatim and the page will
# request a broken script URL — so either set both, or delete the analytics
# <script> tag from client/index.html.

# Host serving the Umami script; the tag requests `<endpoint>/umami`.
VITE_ANALYTICS_ENDPOINT=

# Umami website ID for this site.
VITE_ANALYTICS_WEBSITE_ID=


# -----------------------------------------------------------------------------
# Smoke test scripts (scripts/) — optional
# -----------------------------------------------------------------------------
# Only needed when running the manual scripts in scripts/. Not read by the app.

# Base URL of a RUNNING instance for scripts/recitation-smoke-test.mjs to hit,
# e.g. http://localhost:3000. The script throws if it is unset.
RECITATION_TEST_APP_URL=http://localhost:3000

# Model used by scripts/audio-llm-smoke-test.mjs. Defaults to
# gemini-3-flash-preview. That script also needs the two BUILT_IN_FORGE_* vars.
AUDIO_TEST_MODEL=gemini-3-flash-preview
